# Environment variables for AgriPass AI (Template)
DATABASE_URL="file:./dev.db"

# AI Inference Settings (Open-weight model adapter)
# Supported providers: local_fallback | groq | huggingface | ollama | gemini
AI_PROVIDER="local_fallback"
AI_API_KEY="your-api-key-here"
AI_MODEL="gemma-2-9b-it"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
